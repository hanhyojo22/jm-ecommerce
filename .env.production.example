APP_NAME=JMMart
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://shop.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=jmmart
DB_USERNAME=jmmart
DB_PASSWORD=
POSTGRES_DB=jmmart
POSTGRES_USER=jmmart
POSTGRES_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=default

FILESYSTEM_DISK=public
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=shop.example.com
REVERB_SCALING_ENABLED=true
VITE_REVERB_APP_KEY=${REVERB_APP_KEY}
VITE_REVERB_HOST=shop.example.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

DOMAIN=shop.example.com
CADDY_SITE_ADDRESS=shop.example.com
ACME_EMAIL=ops@example.com
APP_IMAGE=jmmart:latest
